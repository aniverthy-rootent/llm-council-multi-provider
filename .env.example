# Set keys for the vendors you want on the council (at least 2). Providers without a key are skipped.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
# Ollama needs no key; run a local server
# OLLAMA_HOST=http://localhost:11434

# Council members "provider:model,..."  (default: anthropic, openai, gemini, groq)
# COUNCIL=anthropic:claude-sonnet-5-5,openai:gpt-4o,gemini:gemini-2.5-flash,ollama:llama3.2
